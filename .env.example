POSTGRES_DB=cite_nook
POSTGRES_USER=cite_nook
POSTGRES_PASSWORD=checked-in-development-only
DATABASE_URL=postgresql+psycopg://cite_nook:checked-in-development-only@postgres:5432/cite_nook

# Default: use an Ollama instance running outside this Compose project.
# Docker Desktop and modern Docker Engine resolve host.docker.internal through
# the extra_hosts entry in docker-compose.yml. A remote URL works as well.
OLLAMA_HOST=http://host.docker.internal:11434
CHAT_MODELS=llama3.1:8b,qwen3.5:9b
EMBEDDING_MODELS=qwen3-embedding:0.6b,embeddinggemma
DEFAULT_CHAT_MODEL=llama3.1:8b
DEFAULT_EMBEDDING_MODEL=qwen3-embedding:0.6b
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20
EMBEDDING_BATCH_SIZE=32
INGESTION_STALE_MINUTES=15
CHAT_HISTORY_MESSAGES=12
RAG_TOP_K=5
RAG_BACKEND=native

# Host port exposed only by docker-compose.ollama.yml.
OLLAMA_CONTAINER_PORT=11435

# Keep browser requests on the page origin; Vite forwards /api inside Compose.
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://api:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
