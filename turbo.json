{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "UV_LOCKED",
    "UV_PYTHON"
  ],
  "globalPassThroughEnv": [
    "UV_PROJECT_ENVIRONMENT"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@citenook/api#build": {
      "outputs": []
    },
    "@citenook/brand#build": {
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "worker": {
      "cache": false,
      "persistent": true
    }
  }
}
